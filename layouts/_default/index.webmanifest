{
  "name": "{{ site.Title }}",
  "short_name": "{{ site.Title }}",
  "start_url": "{{ site.BaseURL }}",
  "background_color": "#ffffff",
  "theme_color": "#0284c7",
  "display": "standalone",
  "icons": [
    {
      "src": "{{ `images/favicon.png` | absURL }}",
      "sizes": "192x192",
      "type": "image/png"
    }
  ]
}
